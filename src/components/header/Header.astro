---
import { siteConfig } from '../../config';
import './header.scss';
---

<header class="header">
  <div class="header__inner container">
    <a class="header__logo" href={siteConfig.paths.home}>
      <img
        class="header__logo-img"
        src={siteConfig.paths.asset('assets/logo_small.svg')}
        width="239"
        height="98"
        alt="Content Ed Net"
      />
    </a>
  </div>
</header>
