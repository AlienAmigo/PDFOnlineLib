---
import { siteConfig } from '../../config';
import './header.scss';
---

<header class="header">
  <div class="header__inner container">
    <a class="header__logo" href={siteConfig.paths.home}>
      <img
        class="header__logo-img"
        src={siteConfig.paths.asset('assets/logo_small.svg')}
        width="239"
        height="98"
        alt="Content Ed Net"
      />
    </a>
    <button
      class="header__theme-toggle"
      type="button"
      role="switch"
      aria-checked="false"
      data-action="toggle-theme"
      aria-label="Тёмная тема"
      title="Тёмная тема"
    >
      <span class="header__theme-knob" aria-hidden="true">
        <svg
          class="header__theme-icon header__theme-icon--sun"
          width="12"
          height="12"
          viewBox="0 0 18 18"
          fill="none"
        >
          <circle
            cx="9"
            cy="9"
            r="3.6"
            stroke="currentColor"
            stroke-width="1.8"
          ></circle>
          <path
            d="M9 1.5v1.8M9 14.7v1.8M1.5 9h1.8M14.7 9h1.8M3.7 3.7l1.3 1.3M13 13l1.3 1.3M14.3 3.7 13 5M5 13l-1.3 1.3"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          ></path>
        </svg>
        <svg
          class="header__theme-icon header__theme-icon--moon"
          width="12"
          height="12"
          viewBox="0 0 18 18"
          fill="none"
        >
          <path
            d="M15.5 10.7A6.2 6.2 0 0 1 7.3 2.5a6.2 6.2 0 1 0 8.2 8.2Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          ></path>
        </svg>
      </span>
    </button>
  </div>
</header>
