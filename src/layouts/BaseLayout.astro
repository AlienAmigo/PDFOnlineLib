---
import { siteConfig } from '../config';
import '../styles/main.scss';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.title}` : siteConfig.title;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page">
      <header class="header">
        <div class="header__inner container">
          <a class="header__logo" href={siteConfig.paths.home}>
            <svg
              class="header__logo-icon"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M6 2h9l5 5v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1Z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"
              />
              <path
                d="M14 2v6h6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"
              />
            </svg>
            <span class="header__logo-text">{siteConfig.title}</span>
          </a>
        </div>
      </header>

      <main class="page__content container">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer__inner container">
          <p class="footer__copyright">
            &copy; {year} {siteConfig.copyright}. Все права защищены.
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
