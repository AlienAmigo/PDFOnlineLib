---
import { siteConfig } from '../config';
import Header from '../components/header/Header.astro';
import Footer from '../components/footer/Footer.astro';
import '../styles/main.scss';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.title}` : siteConfig.title;

const metrikaId = siteConfig.yandexMetrikaId;
const metrikaInit =
  metrikaId > 0
    ? `(function (m, e, t, r, i, k, a) {
  m[i] = m[i] || function () {
    (m[i].a = m[i].a || []).push(arguments);
  };
  m[i].l = 1 * new Date();
  k = e.createElement(t);
  a = e.getElementsByTagName(t)[0];
  k.async = 1;
  k.src = r;
  a.parentNode.insertBefore(k, a);
})(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
ym(${metrikaId}, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true });`
    : null;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Выставляем тему до первой отрисовки, чтобы не было вспышки светлой темы.
      // Осознанное исключение из конвенции: модульные скрипты выполняются поздно.
      (function () {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          theme = null;
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link
      rel="icon"
      type="image/png"
      href={siteConfig.paths.favicon('favicon-96x96.png')}
      sizes="96x96"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={siteConfig.paths.favicon('favicon.svg')}
    />
    <link rel="shortcut icon" href={siteConfig.paths.favicon('favicon.ico')} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={siteConfig.paths.favicon('apple-touch-icon.png')}
    />
    <meta name="apple-mobile-web-app-title" content={siteConfig.title} />
    <link rel="manifest" href={siteConfig.paths.favicon('site.webmanifest')} />
    <title>{pageTitle}</title>
    {metrikaInit && <script is:inline set:html={metrikaInit} />}
    {metrikaId > 0 && (
      <noscript>
        <div>
          <img
            src={`https://mc.yandex.ru/watch/${metrikaId}`}
            style="position:absolute; left:-9999px;"
            alt=""
          />
        </div>
      </noscript>
    )}
  </head>
  <body>
    <div class="page">
      <Header />

      <main class="page__content container">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>

<script>
  import { initTheme } from '../scripts/theme';

  const header = document.querySelector<HTMLElement>('.header');
  if (header) {
    initTheme(header);
  }
</script>
