---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toolbar from '../../components/viewer/Toolbar.astro';
import { pdfList, getPdfById } from '../../data/pdfs';
import { siteConfig } from '../../config';

export const getStaticPaths: GetStaticPaths = () =>
  pdfList.map((pdf) => ({ params: { id: pdf.id } }));

const { id } = Astro.params;
const pdf = getPdfById(id!);

if (!pdf) {
  return Astro.redirect(siteConfig.paths.notFound);
}
---

<BaseLayout title={pdf.title}>
  <section class="viewer">
    <h1 class="visually-hidden">{pdf.title}</h1>

    <div
      id="pdf-viewer"
      class="viewer__container"
      data-url={pdf.url}
      data-filename={pdf.fileName}
      data-title={pdf.title}
      data-description={pdf.description}
    >
      <Toolbar url={pdf.url} fileName={pdf.fileName} />

      <p class="viewer__status" data-role="status" role="status">
        Загрузка документа…
      </p>

      <div class="viewer__canvas-wrap" data-role="canvas-wrap" hidden>
        <canvas
          class="viewer__canvas"
          data-role="canvas"
          role="img"
          aria-label={pdf.title}
        ></canvas>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initViewer } from '../../scripts/viewer';

  const container = document.getElementById('pdf-viewer');
  if (container instanceof HTMLElement) {
    initViewer(container);
  }
</script>
